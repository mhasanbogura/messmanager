{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "messes": {
          "$mid": {
            ".read": "auth != null",
            ".write": "auth != null && (auth.uid === $uid || (root.child('messes').child($mid).child('members').child(auth.uid).child('role').val() == 'admin' && root.child('messes').child($mid).child('members').child($uid).exists()))"
          }
        }
      }
    },
    "messCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((newData.exists() && root.child('messes').child(newData.val()).child('members').child(auth.uid).child('role').val() == 'admin') || (data.exists() && !newData.exists() && root.child('messes').child(data.val()).child('members').child(auth.uid).child('role').val() == 'admin'))"
      }
    },
    "messes": {
      ".read": "auth != null && query.orderByChild == 'settings/messCode' && query.equalTo != null",
      ".indexOn": ["settings/messCode"],
      "$mid": {
        ".read": "auth != null && (!data.exists() || data.child('members').child(auth.uid).child('role').exists())",
        ".write": "auth != null && ((!data.exists() && newData.child('settings').child('owner').val() == auth.uid && newData.child('settings').child('messCode').isString() && newData.child('members').child(auth.uid).child('role').val() == 'admin') || data.child('members').child(auth.uid).child('role').val() == 'admin')",
        "members": {
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null && (root.child('messes').child($mid).child('members').child(auth.uid).child('role').val() == 'admin' || (auth.uid === $uid && ((data.exists() && (!newData.exists() || newData.child('role').val() == data.child('role').val())) || (!data.exists() && newData.exists() && newData.child('role').val() == 'member' && (root.child('users').child(auth.uid).child('currentMess').val() == $mid || (!root.child('users').child(auth.uid).child('currentMess').exists() && (!root.child('users').child(auth.uid).child('messes').exists() || root.child('users').child(auth.uid).child('messes').child($mid).exists())))))))"
          }
        },
        "settings": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('messes').child($mid).child('members').child(auth.uid).child('role').val() == 'admin'"
        },
        "permissions": {
          "$uid": {
            ".read": "auth != null",
            "$key": {
              ".read": "auth != null",
              ".write": "auth != null && (root.child('messes').child($mid).child('members').child(auth.uid).child('role').val() == 'admin' || root.child('messes').child($mid).child('permissions').child(auth.uid).child('manage').val() === true)"
            }
          }
        },
        "managerRequests": {
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null && (auth.uid === $uid || root.child('messes').child($mid).child('members').child(auth.uid).child('role').val() == 'admin')"
          }
        },
        "online": {
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "meals": {
          ".write": "auth != null && root.child('messes').child($mid).child('members').child(auth.uid).child('role').exists() && (root.child('messes').child($mid).child('members').child(auth.uid).child('role').val() == 'admin' || root.child('messes').child($mid).child('permissions').child(auth.uid).child('mealEntry').val() === true || root.child('messes').child($mid).child('permissions').child(auth.uid).child('mealEdit').val() === true)"
        },
        "mealHistory": {
          ".write": "auth != null && root.child('messes').child($mid).child('members').child(auth.uid).child('role').exists() && (root.child('messes').child($mid).child('members').child(auth.uid).child('role').val() == 'admin' || root.child('messes').child($mid).child('permissions').child(auth.uid).child('mealEntry').val() === true || root.child('messes').child($mid).child('permissions').child(auth.uid).child('mealEdit').val() === true)"
        },
        "bazarItems": {
          ".write": "auth != null && root.child('messes').child($mid).child('members').child(auth.uid).child('role').exists() && (root.child('messes').child($mid).child('members').child(auth.uid).child('role').val() == 'admin' || root.child('messes').child($mid).child('permissions').child(auth.uid).child('bazarEntry').val() === true)"
        },
        "costTrash": {
          ".write": "auth != null && root.child('messes').child($mid).child('members').child(auth.uid).child('role').exists() && (root.child('messes').child($mid).child('members').child(auth.uid).child('role').val() == 'admin' || root.child('messes').child($mid).child('permissions').child(auth.uid).child('bazarEntry').val() === true)"
        },
        "deposits": {
          ".write": "auth != null && root.child('messes').child($mid).child('members').child(auth.uid).child('role').exists() && (root.child('messes').child($mid).child('members').child(auth.uid).child('role').val() == 'admin' || root.child('messes').child($mid).child('permissions').child(auth.uid).child('bazarEntry').val() === true)"
        },
        "depTrash": {
          ".write": "auth != null && root.child('messes').child($mid).child('members').child(auth.uid).child('role').exists() && (root.child('messes').child($mid).child('members').child(auth.uid).child('role').val() == 'admin' || root.child('messes').child($mid).child('permissions').child(auth.uid).child('bazarEntry').val() === true)"
        },
        "notices": {
          ".write": "auth != null && root.child('messes').child($mid).child('members').child(auth.uid).child('role').exists() && (root.child('messes').child($mid).child('members').child(auth.uid).child('role').val() == 'admin' || root.child('messes').child($mid).child('permissions').child(auth.uid).child('manage').val() === true)"
        },
        "menus": {
          ".write": "auth != null && root.child('messes').child($mid).child('members').child(auth.uid).child('role').exists() && (root.child('messes').child($mid).child('members').child(auth.uid).child('role').val() == 'admin' || root.child('messes').child($mid).child('permissions').child(auth.uid).child('manage').val() === true)"
        },
        "bazarDuty": {
          ".write": "auth != null && root.child('messes').child($mid).child('members').child(auth.uid).child('role').exists() && (root.child('messes').child($mid).child('members').child(auth.uid).child('role').val() == 'admin' || root.child('messes').child($mid).child('permissions').child(auth.uid).child('bazarEntry').val() === true)"
        },
        "bazarNote": {
          ".write": "auth != null && root.child('messes').child($mid).child('members').child(auth.uid).child('role').exists() && (root.child('messes').child($mid).child('members').child(auth.uid).child('role').val() == 'admin' || root.child('messes').child($mid).child('permissions').child(auth.uid).child('manage').val() === true)"
        }
      }
    }
  }
}
